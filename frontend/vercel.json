{
  "framework": "vite",
  "rewrites": [
    { "source": "/tool/:slug", "destination": "/tool/:slug/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/category/:slug", "destination": "/category/:slug/index.html" },
    { "source": "/workflow/:slug", "destination": "/workflow/:slug/index.html" },
    { "source": "/:page", "destination": "/:page/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
